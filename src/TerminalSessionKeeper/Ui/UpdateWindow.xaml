<ui:ThemedWindow x:Class="TerminalSessionKeeper.Ui.UpdateWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="UpdateButton" Content="Update" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Update_Click"/>
        <Button x:Name="LaterButton" Content="Later" Margin="8,0,0,0" IsCancel="True" Click="Later_Click"/>
      </StackPanel>
    </Border>
    <DockPanel Margin="22,20">
      <TextBlock x:Name="StateIcon" DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="26" Text="&#xE896;"
                 Foreground="{DynamicResource Accent}" Margin="0,0,14,0" VerticalAlignment="Top"/>
      <StackPanel>
        <TextBlock x:Name="Heading" Style="{StaticResource StrongText}" Margin="0,0,0,6"/>
        <TextBlock x:Name="Message" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Progress" Margin="0,14,0,4" Maximum="1" Visibility="Collapsed"/>
        <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</ui:ThemedWindow>
