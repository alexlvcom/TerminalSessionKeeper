<ui:ThemedWindow x:Class="TerminalSessionKeeper.Ui.HistoryWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="650" Height="560" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <Button x:Name="CloseButton" Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
              IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </Border>
    <Border Style="{StaticResource Card}" Margin="20,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10" Focusable="False">
        <StackPanel x:Name="Entries"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</ui:ThemedWindow>
