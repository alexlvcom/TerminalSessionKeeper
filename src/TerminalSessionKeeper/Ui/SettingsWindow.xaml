<ui:ThemedWindow x:Class="TerminalSessionKeeper.Ui.SettingsWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="780" Height="700" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <!-- Fixed size; no tab scrolls (windows-apps-common-standards.md, Sectioned Settings). -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
          <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="DirtyText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs">
      <!-- Snapshots -->
      <TabItem Header="Snapshots" x:Name="SnapshotsTab">
        <StackPanel>
          <TextBlock Text="AUTOMATIC SNAPSHOTS" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="AutoSnapshot" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <TextBlock Text="Take a snapshot automatically" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="Interval" Width="76" HorizontalContentAlignment="Right"/>
                    <TextBlock Text="minutes" Style="{StaticResource MutedText}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="IntervalLabel" Text="Every"/>
                    <TextBlock x:Name="IntervalError" Text="Enter a number of minutes from 1 to 1440." Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="Keep" Width="76" HorizontalContentAlignment="Right"/>
                    <TextBlock Text="snapshots" Style="{StaticResource MutedText}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Keep the newest"/>
                    <TextBlock x:Name="KeepError" Text="Keep between 1 and 500 snapshots." Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="A snapshot is a few KB. Nothing is written when no tabs are open, so a good snapshot is never replaced by an empty one."/>
        </StackPanel>
      </TabItem>

      <!-- Restoring -->
      <TabItem Header="Restoring" x:Name="RestoringTab">
        <StackPanel>
          <TextBlock Text="AFTER A REBOOT" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="RestoreAfterReboot" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Put the tabs back automatically after a reboot"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Only on the first run after a reboot, and only when no terminal window is already open — restoring beside a live window would put both into the next snapshot."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="AutoResume" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Run each resume command instead of leaving it at the prompt"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Off by default: a dozen agents and their MCP servers all starting at once, right after a reboot, is rarely what you want."/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="RESTORE WINDOW" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
          <Border Style="{StaticResource Card}">
            <Border Style="{StaticResource FirstCardRow}">
              <StackPanel>
                <DockPanel>
                  <TextBox x:Name="WindowName" DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"/>
                  <TextBlock Text="Rebuild tabs into a new window named" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Every restore opens its own window and the name carries the time it ran, so a restore never adds its tabs to the window an earlier one built."/>
              </StackPanel>
            </Border>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Environment -->
      <TabItem Header="Environment" x:Name="EnvironmentTab">
        <StackPanel>
          <TextBlock Text="RESTORED WSL TABS" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}">
                <StackPanel>
                  <TextBlock Text="Custom environment variables for restored WSL tabs, one NAME=value per line:" Margin="0,0,0,8"/>
                  <!-- Fixed height: the box scrolls inside itself, never the tab. -->
                  <TextBox x:Name="WslEnvironment" Height="96" AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                  <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="Added only to the WSL tabs a restore opens. Tabs you open yourself are not affected."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="TypeCd" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Type a cd into each restored WSL tab"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Runs cd into the tab's saved folder once its shell has started, in case the shell changed directory while starting up. Turn it off if yours does not."/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Appearance -->
      <TabItem Header="Appearance" x:Name="AppearanceTab">
        <StackPanel>
          <TextBlock Text="APP THEME" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <Border Style="{StaticResource FirstCardRow}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Theme"/>
                  <TextBlock Text="System follows your Windows light or dark mode and changes with it." Style="{StaticResource MutedText}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>

          <TextBlock Text="RESTORED TABS" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="PinTitles" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Keep saved tab titles, even when the shell renames a tab"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Otherwise a restored tab keeps its saved title until the shell or the agent renames it."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="SampleColors" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Remember tab colours"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Read from each tab's own pixels, since Windows Terminal has no API for them. A colour must read the same twice before it is kept."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="RestoreColors" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Put tab colours back when tabs are rebuilt"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Applied like the colour picker, so its Reset clears it. Briefly adds a setTabColor action to Windows Terminal's settings.json, then removes it."/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- General -->
      <TabItem Header="General" x:Name="GeneralTab">
        <StackPanel>
          <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="Notifications" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <TextBlock Text="Show a notification after a snapshot or restore" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock x:Name="StartWithWindowsLabel"/>
                    <TextBlock Text="Autostart uses the current-user Run key. No elevation, no scheduled task." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Updates -->
      <TabItem Header="Updates" x:Name="UpdatesTab">
        <StackPanel>
          <TextBlock Text="Choose when Terminal Session Keeper checks GitHub for newer releases and updates." Style="{StaticResource LeadText}"/>
          <Border Style="{StaticResource Card}" Padding="16">
            <DockPanel>
              <Ellipse x:Name="UpdateDot" Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
              <StackPanel>
                <TextBlock x:Name="UpdateTitle" Style="{StaticResource StrongText}"/>
                <TextBlock x:Name="UpdateDetail" Style="{StaticResource MutedText}" FontSize="14"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Check for updates" VerticalAlignment="Center" MinWidth="132"/>
              <ComboBox x:Name="Frequency" Margin="10,0,10,0">
                <ComboBoxItem Content="Once an hour"/>
                <ComboBoxItem Content="Once a day (default)"/>
                <ComboBoxItem Content="Once a week"/>
                <ComboBoxItem Content="Once a month"/>
                <ComboBoxItem Content="Never"/>
              </ComboBox>
              <Button x:Name="CheckNowButton" Content="Check for updates" Click="CheckNow_Click"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Reliable automated updates" Style="{StaticResource StrongText}" Margin="0,0,0,2"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"
                         Text="Setup installers are downloaded from official GitHub releases and verified with SHA-256 before running. Scheduled background checks stay quiet and never interrupt terminal restoration."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- About -->
      <TabItem Header="About" x:Name="AboutTab">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="AboutTitle" Style="{StaticResource TitleText}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14">
                <Run x:Name="AboutBuild"/>
                <Hyperlink x:Name="RepoLink" Click="Repo_Click">github.com/alexlvcom/TerminalSessionKeeper</Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="NotesHeader" Style="{StaticResource StrongText}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource Card}" Height="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10" Focusable="False">
              <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
          </Border>
          <Button Style="{StaticResource LinkButton}" Content="View full change history" Click="History_Click"
                  Margin="0,12,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </TabItem>

      <!-- Diagnostics -->
      <TabItem Header="Diagnostics" x:Name="DiagnosticsTab">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Copy details" Click="CopyDetails_Click" VerticalAlignment="Center"/>
            <TextBlock Text="Where Terminal Session Keeper runs from and keeps its settings, snapshots and logs."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
          </DockPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="PathsPanel"/>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</ui:ThemedWindow>
