<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WinForms hosts the tray icon and the message loop; every window is WPF with the shared
         AlexLV.WindowsUi kit (see AlexLV.WindowsUi in C:\projects and AGENTS.md). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF draws the windows. Tab titles are also readable only through UI Automation, and
         System.Windows.Automation ships in the WPF framework reference. The COM IUIAutomation
         interfaces would avoid it, but hand-declared vtables are a crash away from a wrong slot;
         the managed wrapper is the one the reference implementation proved on this machine. -->
    <UseWPF>true</UseWPF>
    <!-- Tab colours are read by rendering the terminal and sampling the pixels under each tab's
         UI Automation rectangle. A system-aware process gets those rectangles scaled whenever
         the terminal sits on a monitor with other scaling than the one at sign-in, while the
         render stays in physical pixels — so every tab was read a little further to the left
         than it is, and a colour landed on the neighbouring tab. Per-monitor awareness makes
         both physical. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TerminalSessionKeeper</RootNamespace>
    <AssemblyName>TerminalSessionKeeper</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <InformationalVersion>1.4.1</InformationalVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The name people read. The assembly, the folder and the Run-key value stay one word;
         see AppInfo.cs. -->
    <Product>Terminal Session Keeper</Product>
    <AssemblyTitle>Terminal Session Keeper</AssemblyTitle>
    <Authors>Alex LV</Authors>
    <Company>Alex LV</Company>
    <Copyright>Copyright © 2026 Alex LV</Copyright>
    <Description>Saves open Windows Terminal tabs, including live claude and codex sessions, and rebuilds them after a restart.</Description>
    <DebugType>embedded</DebugType>

    <!-- Idle cost: the app only works on a UI event or a timer tick, so a non-concurrent
         workstation GC keeps the resident set and background threads minimal. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- WPF text layout creates real cultures (for example "en") when it measures fonts; invariant
         globalization makes the first TextBox throw and crash the app. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- SQLite ships as a native library. A single-file publish leaves native libraries beside
         the executable unless this is set, and the app is meant to be one file you can copy
         anywhere — without it, codex sessions fail to resolve on the deployed build only. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Codex keeps its resumable threads in SQLite; there is no way to read them without a
         SQLite engine, and the bundled native provider keeps the app self-contained. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms and WPF share type names (Button, TextBox, Application, MessageBox); files opt
         in to WinForms and System.Drawing explicitly instead of through implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The WinForms and WPF implicit-using sets drop these. Nearly everything here touches the
         file system. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>CHANGELOG.md</LogicalName>
    </EmbeddedResource>
    <!-- The WSL side has to be walked from inside the distro (/proc, and the Linux codex
         state), so the probe is carried in the executable and staged into the distro on
         each snapshot. Nothing is installed into the user's dotfiles. -->
    <EmbeddedResource Include="Terminal\snapshot-agents.py" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerminalSessionKeeper.Tests" />
  </ItemGroup>
</Project>
